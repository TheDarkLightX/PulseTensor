{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsetensor.org/schemas/evaluation-reveal-v1.json",
  "title": "PulseTensor EvaluationRevealV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluationVersion",
    "chainId",
    "evaluationContract",
    "taskId",
    "receiptHash",
    "evaluationPolicyHash",
    "evaluator",
    "scoreVector",
    "evidenceRoot",
    "salt",
    "evaluatorNonce",
    "evaluatorSignature"
  ],
  "properties": {
    "schema": {"const": "pulsetensor/evaluation-reveal/v1"},
    "evaluationVersion": {"const": "1"},
    "chainId": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "evaluationContract": {"$ref": "#/$defs/address"},
    "taskId": {"$ref": "#/$defs/hash32"},
    "receiptHash": {"$ref": "#/$defs/hash32"},
    "evaluationPolicyHash": {"$ref": "#/$defs/hash32"},
    "evaluator": {"$ref": "#/$defs/address"},
    "scoreVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "scoreBps"],
        "properties": {
          "criterionId": {"$ref": "#/$defs/hash32"},
          "scoreBps": {"type": "integer", "minimum": 0, "maximum": 10000}
        }
      }
    },
    "evidenceRoot": {"$ref": "#/$defs/hash32"},
    "salt": {"$ref": "#/$defs/hash32"},
    "evaluatorNonce": {"$ref": "#/$defs/uintString"},
    "evaluatorSignature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "hash32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"},
    "uintString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "x-pulsetensor-uintBits": 256
    }
  }
}
