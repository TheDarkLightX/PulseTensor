    "pause_blocks": [
      "new task creation",
      "new funding",
      "new assignment"
    ],
    "pause_never_blocks": [
      "already-authorized submission",
      "evaluation reveal",
      "challenge",
      "timeout resolution",
      "finalization",
      "refund conversion",
      "bond release or slash conversion",
      "claim withdrawal"
