  "assurance_modes": [
    {
      "id": "EXACT",
      "claim": "A registered verifier accepted the committed output under the committed canonical semantics.",
      "decision_rule": "VERIFIER_BOOLEAN",
      "required_receipt_fields": [
        "canonicalSemanticsId",
        "inputCommitment",
        "outputCommitment",
        "proofSystemId",
        "verifierId",
        "evidenceRoot",
        "tcbManifestHash"
      ],
      "challenge_behavior": "Verifier failure rejects; verifier success may finalize without subjective scoring.",
      "excluded_guarantee": "Real-world truth and usefulness are not implied unless encoded in the verified predicate."
    },
    {
      "id": "OPTIMISTIC",
      "claim": "The committed trace survived the dispute window or the registered dispute verifier resolved it as valid.",
      "decision_rule": "UNCHALLENGED_OR_DISPUTE_VERIFIED",
      "required_receipt_fields": [
        "canonicalSemanticsId",
        "inputCommitment",
        "outputCommitment",
        "evidenceRoot",
        "availabilityAttestationRoot",
        "verifierId",
        "tcbManifestHash"
      ],
      "challenge_behavior": "Mandatory evidence availability and a bounded fraud-proof window precede finality.",
      "excluded_guarantee": "No security claim holds if required dispute data was unavailable or no honest challenger could act."
    },
    {
      "id": "STATISTICAL",
      "claim": "The committed output met the preregistered score rule on the committed sampling frame with the reported uncertainty.",
      "decision_rule": "CAPPED_WEIGHTED_MEDIAN",
      "required_receipt_fields": [
        "inputCommitment",
        "outputCommitment",
        "evidenceRoot",
        "availabilityAttestationRoot",
        "tcbManifestHash"
      ],
      "challenge_behavior": "Invalid evaluation commitments, reveals, or evidence can be challenged; score disagreement alone is not fraud.",
