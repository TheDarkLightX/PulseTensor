{
  "schema": "pulsetensor/target-protocol/v1",
  "spec_id": "PULSETENSOR-TARGET-V1",
  "version": "1.0.0",
  "status": "target_unimplemented",
  "title": "PulseTensor evidence-bearing task network target",
  "normative_language": "RFC2119",
  "scope": {
    "included": [
      "asset-local bounty escrow",
      "same-asset provider and evaluator bonds",
      "typed task and receipt commitments",
      "task-local quality consensus",
      "authenticated node discovery and requests",
      "governance snapshots, refunds, nullifiers, and pull claims"
    ],
    "excluded": [
      "a guarantee of external purchasing power",
      "a protocol salary or guaranteed income",
      "cross-asset valuation or netting",
      "a universal proof that AI output is true or useful",
      "Sybil-proof identity",
      "permissionless distributed training in version 1"
    ]
  },
  "normative_documents": [
    "docs/protocol/defi_native_economics_v1.md",
