  "current_implementation_boundary": {
    "native_asset": "PLS",
    "facts": [
      "PulseTensorCore coordinates subnets, stake, registration, commit/reveal, slashing, and explicit native-PLS emission pools.",
      "PulseTensorInferenceSettlement is a native-PLS optimistic batch shell with replay and duplicate-leaf challenges.",
      "The current weightsHash reveal is not a score vector and does not determine participant payouts.",
      "The current batch shell does not implement the target task, evaluator, evidence, or per-task decision lifecycle.",
      "This target specification is design evidence, not evidence that the planned modules are implemented or formally proved."
    ]
  },
