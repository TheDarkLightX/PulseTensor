{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsetensor.org/schemas/node-descriptor-v1.json",
  "title": "PulseTensor NodeDescriptorV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "descriptorVersion",
    "chainId",
    "nodeRegistry",
    "netuid",
    "mechid",
    "controller",
    "operator",
    "roleBitmap",
    "sequence",
    "validFromBlock",
    "validUntilBlock",
    "endpointSet",
    "tlsCertificateHash",
    "capabilityManifestHash",
    "supportedTaskVersions",
    "supportedReceiptVersions",
    "supportedAssuranceModes",
    "acceptedAssetSetHash",
    "availabilityModes",
    "maxRequestBytes",
    "maxConcurrentTasks",
    "softwareArtifactHash",
    "operatorSignature"
  ],
  "properties": {
    "schema": {"const": "pulsetensor/node-descriptor/v1"},
    "descriptorVersion": {"const": "1"},
    "chainId": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nodeRegistry": {"$ref": "#/$defs/address"},
    "netuid": {"type": "integer", "minimum": 0, "maximum": 65535},
    "mechid": {"type": "integer", "minimum": 0, "maximum": 65535},
    "controller": {"$ref": "#/$defs/address"},
    "operator": {"$ref": "#/$defs/address"},
    "roleBitmap": {"$ref": "#/$defs/uintString"},
    "sequence": {"$ref": "#/$defs/uintString"},
    "validFromBlock": {"$ref": "#/$defs/uintString"},
    "validUntilBlock": {"$ref": "#/$defs/uintString"},
    "endpointSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transport", "uri"],
        "properties": {
          "transport": {"enum": ["HTTPS", "WSS"]},
          "uri": {"type": "string", "minLength": 8, "maxLength": 512}
        }
      }
    },
    "tlsCertificateHash": {"$ref": "#/$defs/hash32"},
    "capabilityManifestHash": {"$ref": "#/$defs/hash32"},
    "supportedTaskVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}
    },
    "supportedReceiptVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}
    },
    "supportedAssuranceModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assuranceMode"}
    },
    "acceptedAssetSetHash": {"$ref": "#/$defs/hash32"},
    "availabilityModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["INLINE_PUBLIC", "CONTENT_ADDRESSED_PUBLIC", "REQUESTER_REPRODUCIBLE", "PROOF_ONLY"]}
    },
    "maxRequestBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "maxConcurrentTasks": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "softwareArtifactHash": {"$ref": "#/$defs/hash32"},
    "operatorSignature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "hash32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"},
    "uintString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "x-pulsetensor-uintBits": 256
    },
    "assuranceMode": {
      "enum": ["EXACT", "OPTIMISTIC", "STATISTICAL", "ATTESTED", "REQUESTER_ACCEPTED"]
    }
  }
}
